PORT=4000
CLIENT_URL=http://localhost:5173

# Auth0 API settings. AUTH0_SECRET is optional; leave blank when using RS256.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_SECRET=

# Backend service credentials
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Local demo only. Keep false outside development.
DEV_BYPASS_AUTH=false
DEV_ACCOUNT_ID=

# Filled in by `npm run seed`; leave blank before seeding.
ACCOUNT_ID=
CUSTOMER_ID=
MICHAEL_ACCOUNT_ID=
